root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.php]
indent_size = 4

# O PowerShell 5.1 só lê os acentos com o BOM
[*.ps1]
charset = utf-8-bom
indent_size = 4

[*.md]
trim_trailing_whitespace = false
